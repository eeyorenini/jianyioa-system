<template>
  <div class="contract-templates-editor">
    <el-card>
      <template #header>
        <div class="card-header">
          <span>合同模板管理</span>
          <el-button type="primary" @click="openEditor(null)">新增模板</el-button>
        </div>
      </template>

      <el-tabs v-model="activeTab" @tab-change="loadData">
        <el-tab-pane label="系统模板" name="system" />
        <el-tab-pane label="个人模板" name="personal" />
      </el-tabs>

      <el-table :data="filteredTemplates" style="width:100%">
        <el-table-column prop="name" label="名称" />
        <el-table-column prop="category" label="分类" />
        <el-table-column label="操作" width="150">
          <template #default="{row}">
            <el-button size="small" type="primary" @click="openEditor(row)">编辑</el-button>
            <el-button size="small" type="danger" @click="handleDelete(row.id)">删除</el-button>
          </template>
        </el-table-column>
      </el-table>
    </el-card>

    <!-- 编辑对话框 -->
    <el-dialog v-model="showDialog" :title="form.id?'编辑模板':'新增模板'" width="90%" top="2vh">
      <div class="editor-container">
        <!-- 变量快捷栏 -->
        <div class="var-bar">
          <div class="var-section">
            <span class="var-label">固定：</span>
            <el-tag
              v-for="v in builtInVariables"
              :key="v.name"
              class="var-item"
              type="success"
              effect="plain"
              style="cursor:pointer"
              @click="insertVar(v)"
            >
              {{ v.label }}
            </el-tag>
          </div>
          <div class="var-section" v-if="customVariables.length > 0">
            <span class="var-label">自定义：</span>
            <el-tag
              v-for="v in customVariables"
              :key="v.name"
              class="var-item"
              type="warning"
              effect="plain"
              closable
              @close="deleteCustomVar(v)"
              style="cursor:pointer"
              @click="insertVar(v)"
            >
              {{ v.label }}
            </el-tag>
          </div>
          <div class="var-section" v-if="computedVarList.length > 0">
            <span class="var-label">计算：</span>
            <el-tag
              v-for="cv in computedVarList"
              :key="cv.name"
              class="var-item"
              type="info"
              effect="plain"
              closable
              @close="removeComputedVar(cv)"
              style="cursor:pointer"
              @click="openEditComputedVar(cv)"
            >
              {{ cv.label }}
            </el-tag>
          </div>
          <div class="var-btn-row">
            <el-button size="small" type="warning" plain icon="Plus" @click="showAddVar = true">添加自定义变量</el-button>
            <el-button size="small" type="info" plain icon="Plus" @click="openAddComputedVar">添加计算变量</el-button>
          </div>
        </div>

        <!-- 编辑器工具栏 -->
        <div class="editor-toolbar" v-if="editor">
          <button type="button" @click="editor.chain().focus().undo().run()" :disabled="!editor.can().undo()">↩ 撤销</button>
          <button type="button" @click="editor.chain().focus().redo().run()" :disabled="!editor.can().redo()">↪ 重做</button>
          <div class="toolbar-divider"></div>

          <select @change="setHeading($event.target.value)">
            <option value="">正文</option>
            <option value="1">标题1</option>
            <option value="2">标题2</option>
            <option value="3">标题3</option>
            <option value="4">标题4</option>
          </select>
          <div class="toolbar-divider"></div>

          <button type="button" @click="editor.chain().focus().toggleBold().run()" :class="{ active: editor.isActive('bold') }"><b>B</b></button>
          <button type="button" @click="editor.chain().focus().toggleItalic().run()" :class="{ active: editor.isActive('italic') }"><i>I</i></button>
          <button type="button" @click="editor.chain().focus().toggleUnderline().run()" :class="{ active: editor.isActive('underline') }"><u>U</u></button>
          <button type="button" @click="editor.chain().focus().toggleStrike().run()" :class="{ active: editor.isActive('strike') }"><s>S</s></button>
          <div class="toolbar-divider"></div>

          <select @change="setFontFamily($event.target.value)">
            <option value="Microsoft YaHei">微软雅黑</option>
            <option value="SimSun">宋体</option>
            <option value="SimHei">黑体</option>
            <option value="FangSong">仿宋</option>
            <option value="Arial">Arial</option>
          </select>
          <div class="toolbar-divider"></div>

          <button type="button" @click="editor.chain().focus().setTextAlign('left').run()" :class="{ active: editor.isActive({ textAlign: 'left' }) }">⫷</button>
          <button type="button" @click="editor.chain().focus().setTextAlign('center').run()" :class="{ active: editor.isActive({ textAlign: 'center' }) }">≡</button>
          <button type="button" @click="editor.chain().focus().setTextAlign('right').run()" :class="{ active: editor.isActive({ textAlign: 'right' }) }">⫸</button>
          <div class="toolbar-divider"></div>

          <button type="button" @click="editor.chain().focus().toggleBulletList().run()" :class="{ active: editor.isActive('bulletList') }">•</button>
          <button type="button" @click="editor.chain().focus().toggleOrderedList().run()" :class="{ active: editor.isActive('orderedList') }">1.</button>
          <div class="toolbar-divider"></div>

          <button type="button" @click="insertTable">▦ 表格</button>
          <button type="button" @click="editor.chain().focus().setHorizontalRule().run()">— 分隔线</button>
          <div class="toolbar-divider"></div>

          <button type="button" @click="triggerImageUpload">📷 图片</button>
          <button type="button" @click="triggerPdfUpload">📄 PDF</button>
          <input ref="imageUploadRef" type="file" accept="image/*" style="display:none" @change="handleImageUpload" />
          <input ref="pdfUploadRef" type="file" accept="application/pdf" style="display:none" @change="handlePdfUpload" />
        </div>

        <!-- A4打印预览区域 -->
        <div class="a4-preview" v-if="editor">
          <div class="a4-page">
            <div class="a4-header">简逸装饰——{{ categoryMap[form.category] || '合同' }}</div>
            <editor-content :editor="editor" class="a4-content" />
            <div class="a4-footer">
              <span>第 1 页 / 共 {{ totalPages }} 页</span>
            </div>
          </div>
        </div>

        <!-- 表单 -->
        <div class="form-row">
          <el-form :model="form" inline>
            <el-form-item label="名称"><el-input v-model="form.name" style="width:180px" /></el-form-item>
            <el-form-item label="分类">
              <el-select v-model="form.category" style="width:120px">
                <el-option label="装修合同" value="decoration" />
                <el-option label="设计合同" value="design" />
                <el-option label="其他" value="other" />
              </el-select>
            </el-form-item>
          </el-form>
        </div>
      </div>
      <template #footer>
        <el-button @click="showDialog=false">取消</el-button>
        <el-button type="primary" @click="handleSave">保存</el-button>
      </template>
    </el-dialog>

    <!-- 添加自定义变量对话框 -->
    <el-dialog v-model="showAddVar" title="添加自定义变量" width="400px">
      <el-form :model="newVar" label-width="80px">
        <el-form-item label="变量名">
          <el-input v-model="newVar.label" placeholder="请输入变量名，如: 甲方姓名" />
        </el-form-item>
      </el-form>
      <template #footer>
        <el-button @click="showAddVar=false">取消</el-button>
        <el-button type="primary" @click="addCustomVar">添加</el-button>
      </template>
    </el-dialog>

    <!-- 添加计算变量 -->
    <el-dialog v-model="showAddComputedVarDialog" title="添加计算变量" width="400px">
      <el-form :model="newComputedVar" label-width="80px">
        <el-form-item label="变量名">
          <el-input v-model="newComputedVar.label" placeholder="请输入变量名，如: 金额大写" />
        </el-form-item>
        <el-form-item label="计算类型">
          <el-select v-model="newComputedVar.type" style="width:100%">
            <el-option label="大写金额" value="upper" />
            <el-option label="比例计算" value="ratio" />
          </el-select>
        </el-form-item>
        <el-form-item label="关联变量">
          <el-select v-model="newComputedVar.sourceVar" placeholder="请选择金额变量" style="width:100%">
            <el-option v-for="v in amountVars" :key="v.name" :label="v.label" :value="v.name" />
          </el-select>
        </el-form-item>
        <el-form-item v-if="newComputedVar.type === 'ratio'" label="比例(%)">
          <el-input v-model="newComputedVar.ratio" placeholder="如: 5 表示 5%" />
        </el-form-item>
      </el-form>
      <template #footer>
        <el-button @click="showAddComputedVarDialog=false">取消</el-button>
        <el-button type="primary" @click="addComputedVar">添加</el-button>
      </template>
    </el-dialog>

    <!-- 编辑计算变量 -->
    <el-dialog v-model="showEditComputedVarDialog" title="编辑计算变量" width="400px">
      <el-form :model="editingComputedVar" label-width="80px">
        <el-form-item label="变量名">
          <el-input v-model="editingComputedVar.label" placeholder="请输入变量名" />
        </el-form-item>
        <el-form-item label="计算类型">
          <el-select v-model="editingComputedVar.type" style="width:100%">
            <el-option label="大写金额" value="upper" />
            <el-option label="比例计算" value="ratio" />
          </el-select>
        </el-form-item>
        <el-form-item label="关联变量">
          <el-select v-model="editingComputedVar.sourceVar" placeholder="请选择金额变量" style="width:100%">
            <el-option v-for="v in amountVars" :key="v.name" :label="v.label" :value="v.name" />
          </el-select>
        </el-form-item>
        <el-form-item v-if="editingComputedVar.type === 'ratio'" label="比例(%)">
          <el-input v-model="editingComputedVar.ratio" placeholder="如: 5 表示 5%" />
        </el-form-item>
      </el-form>
      <template #footer>
        <el-button @click="showEditComputedVarDialog=false">取消</el-button>
        <el-button type="primary" @click="saveComputedVar">保存</el-button>
      </template>
    </el-dialog>
  </div>
</template>

<script setup>
import { ref, reactive, computed, onMounted, watch, onBeforeUnmount, shallowRef } from 'vue'
import { useEditor, EditorContent } from '@tiptap/vue-3'
import StarterKit from '@tiptap/starter-kit'
import Placeholder from '@tiptap/extension-placeholder'
import Typography from '@tiptap/extension-typography'
import Underline from '@tiptap/extension-underline'
import TextAlign from '@tiptap/extension-text-align'
import { FontFamily } from '@tiptap/extension-font-family'
import { TextStyle } from '@tiptap/extension-text-style'
import Highlight from '@tiptap/extension-highlight'
import { Table } from '@tiptap/extension-table'
import { TableRow } from '@tiptap/extension-table-row'
import { TableCell } from '@tiptap/extension-table-cell'
import { TableHeader } from '@tiptap/extension-table-header'
import Link from '@tiptap/extension-link'
import Image from '@tiptap/extension-image'
import axios from 'axios'
import { ElMessage, ElMessageBox } from 'element-plus'

const editorRef = ref(null)
const showAddVar = ref(false)
const showDialog = ref(false)
const newVar = reactive({ name: '', label: '' })

// 计算变量弹窗状态
const showAddComputedVarDialog = ref(false)
const newComputedVar = reactive({ name: '', label: '', type: 'upper', sourceVar: '', ratio: '' })
const showEditComputedVarDialog = ref(false)
const editingComputedVar = reactive({ name: '', label: '', type: 'upper', sourceVar: '', ratio: '' })

// 可用于比例计算的金额变量
const amountVars = computed(() => {
  const all = [...builtInVariables.value, ...customVariables.value]
  return all.filter(v => v.name && !v.name.startsWith('$'))
})

// 内置变量
const builtInVariables = ref([
  { name: 'contract_no', label: '合同编号' },
  { name: 'customer_name', label: '客户姓名' },
  { name: 'customer_phone', label: '客户电话' },
  { name: 'id_card', label: '身份证号' },
  { name: 'engineering_address', label: '施工地址' },
  { name: 'customer_address', label: '客户地址' },
  { name: 'project_name', label: '项目名称' },
  { name: 'total_amount', label: '合同总额' },
  { name: 'design_fee', label: '设计费' },
  { name: 'manager_fee', label: '管理费' },
  { name: 'start_date', label: '开工日期' },
  { name: 'end_date', label: '竣工日期' },
  { name: 'sign_date', label: '签订日期' },
  { name: 'company_name', label: '公司名称' },
  { name: 'company_phone', label: '公司电话' },
  { name: 'company_address', label: '公司地址' },
  { name: 'party_a', label: '甲方（客户）' },
  { name: 'party_b', label: '乙方（施工方）' },
])

// 自定义变量
const customVariables = ref([])

// 计算变量（从模板加载）
const computedVarList = ref([])

// 所有变量（含计算变量）
const allVariables = computed(() => [...builtInVariables.value, ...customVariables.value, ...computedVarList.value])

// 分类映射
const categoryMap = {
  decoration: '装修合同',
  design: '设计合同',
  other: '其他'
}

// 编辑器实例 - 使用 shallowRef 避免 useEditor 返回值的深层响应式问题
const editor = shallowRef(null)

// 表单
const templateList = ref([])
const activeTab = ref('system')
const form = reactive({
  id: null, name: '', category: 'decoration', content: '', template_type: 'personal'
})

// 分页（简化处理）
const totalPages = computed(() => {
  return 1 // 简化版，实际需要根据内容计算
})

const filteredTemplates = computed(() => templateList.value.filter(t => t.template_type === activeTab.value))

// 创建编辑器
const createNewEditor = () => {
  // 销毁旧编辑器
  if (editor.value) {
    editor.value.destroy()
    editor.value = null
  }
  // 创建新编辑器
  editor.value = useEditor({
    content: '<p></p>',
    extensions: [
      StarterKit.configure({
        heading: {
          levels: [1, 2, 3, 4]
        }
      }),
      Placeholder.configure({
        placeholder: '在此输入合同内容...'
      }),
      Typography,
      Underline,
      TextAlign.configure({
        types: ['heading', 'paragraph']
      }),
      FontFamily,
      TextStyle,
      Highlight,
      Table.configure({
        resizable: true
      }),
      TableRow,
      TableCell,
      TableHeader,
      Link.configure({
        openOnClick: false
      }),
      Image.configure({ inline: false, allowBase64: true }),
    ],
    editorProps: {
      attributes: {
        class: 'prose'
      }
    }
  })
}

// 加载数据
const loadData = async () => {
  try {
    const res = await axios.get('/api/contract-templates')
    templateList.value = res.data || []
  } catch (e) { console.error(e) }
}

// 加载自定义变量
const loadCustomVars = async () => {
  try {
    const res = await axios.get('/api/contract-variables')
    customVariables.value = res.data || []
  } catch (e) {
    console.error('加载变量失败:', e)
  }
}

// 添加自定义变量
const addCustomVar = async () => {
  if (!newVar.label) {
    ElMessage.warning('请填写变量名')
    return
  }
  // 自动生成 name：从显示名转换
  const generatedName = newVar.label
    .replace(/[^a-zA-Z0-9\u4e00-\u9fa5]/g, '_')
    .replace(/([A-Z])/g, '_$1')
    .toLowerCase()
    .replace(/\u4e00-\u9fa5/g, (ch) => ch.charCodeAt(0).toString(16))
    .replace(/_0x/g, '_')
  const exists = allVariables.value.some(v => v.name === generatedName)
  if (exists) {
    ElMessage.warning('变量名已存在')
    return
  }
  try {
    const res = await axios.post('/api/contract-variables', {
      name: generatedName,
      label: newVar.label
    })
    if (res.data.success) {
      customVariables.value.push({ id: res.data.id, name: generatedName, label: newVar.label })
      newVar.name = ''
      newVar.label = ''
      ElMessage.success('添加成功')
    }
  } catch (e) {
    ElMessage.error('添加失败')
  }
}

// 删除自定义变量
const deleteCustomVar = async (varItem) => {
  if (!varItem.id) {
    ElMessage.error('无法删除内置变量或ID不存在')
    return
  }
  try {
    await axios.delete('/api/contract-variables/' + varItem.id)
    const idx = customVariables.value.findIndex(v => v.id === varItem.id)
    if (idx >= 0) customVariables.value.splice(idx, 1)
    ElMessage.success('删除成功')
  } catch (e) {
    ElMessage.error('删除失败')
  }
}

// 打开添加计算变量弹窗
const openAddComputedVar = () => {
  newComputedVar.name = ''
  newComputedVar.label = ''
  newComputedVar.type = 'upper'
  newComputedVar.sourceVar = ''
  newComputedVar.ratio = ''
  showAddComputedVarDialog.value = true
}

// 添加计算变量
const addComputedVar = () => {
  if (!newComputedVar.label) return ElMessage.warning('请填写变量名')
  if (!newComputedVar.sourceVar) return ElMessage.warning('请选择关联变量')
  if (!newComputedVar.name) {
    newComputedVar.name = newComputedVar.label
      .replace(/[^a-zA-Z0-9\u4e00-\u9fa5]/g, '_')
      .replace(/([A-Z])/g, '_$1')
      .toLowerCase()
      .replace(/\u4e00-\u9fa5/g, (ch) => ch.charCodeAt(0).toString(16))
      .replace(/_0x/g, '_')
  }
  if (computedVarList.value.some(cv => cv.name === newComputedVar.name)) return ElMessage.warning('变量名已存在')
  computedVarList.value.push({ ...newComputedVar })
  showAddComputedVarDialog.value = false
  ElMessage.success('添加成功')
}

// 打开编辑计算变量弹窗
const openEditComputedVar = (cv) => {
  Object.assign(editingComputedVar, cv)
  showEditComputedVarDialog.value = true
}

// 保存编辑的计算变量
const saveComputedVar = () => {
  const idx = computedVarList.value.findIndex(cv => cv.name === editingComputedVar.name)
  if (idx >= 0) {
    computedVarList.value.splice(idx, 1, { ...editingComputedVar })
  }
  showEditComputedVarDialog.value = false
  ElMessage.success('保存成功')
}

// 删除计算变量
const removeComputedVar = (cv) => {
  const idx = computedVarList.value.findIndex(v => v.name === cv.name)
  if (idx >= 0) computedVarList.value.splice(idx, 1)
}

// 插入变量
const insertVar = (v) => {
  if (!editor.value) return
  editor.value.chain().focus().insertContent(`{${v.name}}`).run()
}

// 设置标题
const setHeading = (level) => {
  if (!editor.value) return
  if (level) {
    editor.value.chain().focus().toggleHeading({ level: parseInt(level) }).run()
  } else {
    editor.value.chain().focus().setParagraph().run()
  }
}

// 设置字体
const setFontFamily = (font) => {
  if (!editor.value) return
  editor.value.chain().focus().setFontFamily(font).run()
}

// 插入表格
const insertTable = () => {
  if (!editor.value) return
  editor.value.chain().focus().insertTable({ rows: 3, cols: 3, withHeaderRow: true }).run()
}

// 触发图片上传
const imageUploadRef = ref(null)
const triggerImageUpload = () => {
  imageUploadRef.value?.click()
}

//触发PDF上传
const pdfUploadRef = ref(null)
const triggerPdfUpload = () => {
  pdfUploadRef.value?.click()
}

// 处理图片上传
const handleImageUpload = async (e) => {
  const file = e.target.files?.[0]
  if (!file || !editor.value) return
  try {
    const formData = new FormData()
    formData.append('file', file)
    const { data } = await axios.post('/api/upload-image', formData, {
      headers: { 'Content-Type': 'multipart/form-data' }
    })
    if (data.url) {
      editor.value.chain().focus().setImage({ src: data.url }).run()
      ElMessage.success('图片插入成功')
    } else {
      ElMessage.error(data.error || '图片上传失败')
    }
  } catch (err) {
    ElMessage.error('图片上传失败')
  } finally {
    e.target.value = '' // 清空input以便重复选择同一文件
  }
}

// 处理PDF上传（转成多页预览图后依次插入）
const handlePdfUpload = async (e) => {
  const file = e.target.files?.[0]
  if (!file || !editor.value) return
  try {
    const formData = new FormData()
    formData.append('file', file)
    const { data } = await axios.post('/api/upload-pdf', formData, {
      headers: { 'Content-Type': 'multipart/form-data' }
    })
    if (data.urls && data.urls.length) {
      // 依次插入每一页的预览图（每次插入后等待50ms让渲染完成）
      for (const url of data.urls) {
        editor.value.chain().focus().setImage({ src: url }).run()
        await new Promise(r => setTimeout(r, 50))
      }
      ElMessage.success(`PDF 插入成功（共 ${data.urls.length} 页）`)
    } else {
      ElMessage.error(data.error || 'PDF 处理失败')
    }
  } catch (err) {
    ElMessage.error('PDF 处理失败')
  } finally {
    e.target.value = ''
  }
}

// 打开编辑器 - 使用 watch 模式，useEditor 在 setup 同步调用
const openEditor = (row) => {
  if (row) {
    Object.assign(form, row)
    // 解析 template_fields（支持旧格式数组和新格式 {vars, computed}）
    try {
      const fields = row.template_fields ? JSON.parse(row.template_fields) : []
      if (Array.isArray(fields)) {
        // 旧格式：直接是变量数组
        customVariables.value = fields.filter(v => !v.type && !v.sourceVar)
        computedVarList.value = fields.filter(v => v.type && v.sourceVar)
      } else {
        // 新格式：{vars, computed}
        customVariables.value = fields.vars || []
        computedVarList.value = fields.computed || []
      }
    } catch (e) {
      customVariables.value = []
      computedVarList.value = []
    }
  } else {
    Object.keys(form).forEach(k => form[k] = k === 'category' ? 'decoration' : k === 'template_type' ? 'personal' : '')
    form.content = ''
    customVariables.value = []
    computedVarList.value = []
  }
  showDialog.value = true
  // 内容会在 watch 中设置
}

// watch showDialog，在对话框打开后设置内容
watch(showDialog, (val) => {
  if (val) {
    // 对话框打开后，延迟设置内容确保 DOM 已渲染
    setTimeout(() => {
      if (editor.value) {
        editor.value.commands.setContent(form.content || '<p></p>', false)
        editor.value.commands.focus()
      }
    }, 100)
  } else {
    // 对话框关闭时，不销毁编辑器也不清空内容，保留 form.content
  }
})

// 保存
const handleSave = async () => {
  if (!form.name) return ElMessage.warning('请输入名称')

  form.content = editor.value ? editor.value.getHTML() : ''
  // 延迟一下确保编辑器状态完全同步
  await new Promise(r => setTimeout(r, 50))
  form.content = editor.value ? editor.value.getHTML() : ''
  console.log('【调试】保存时 editor 内容：', form.content.substring(0, 500))

  try {
    const user = JSON.parse(localStorage.getItem('user') || '{}')
    // 序列化时同时保存自定义变量和计算变量
    const template_fields = JSON.stringify({
      vars: customVariables.value.map(v => ({ name: v.name, label: v.label })),
      computed: computedVarList.value.map(cv => ({ name: cv.name, label: cv.label, type: cv.type, sourceVar: cv.sourceVar, ratio: cv.ratio }))
    })
    const payload = { ...form, template_fields }
    if (form.id) {
      await axios.put(`/api/contract-templates/${form.id}`, payload, {
        headers: { 'x-user-id': user.id || 0 }
      })
    } else {
      await axios.post('/api/contract-templates', payload, {
        headers: { 'x-user-id': user.id || 0 }
      })
    }
    ElMessage.success('保存成功')
    showDialog.value = false
    loadData()
  } catch (e) {
    ElMessage.error(e?.response?.data?.message || '保存失败')
  }
}

// 删除
const handleDelete = async (id) => {
  try {
    await ElMessageBox.confirm('确定删除?', '提示', { type: 'warning' })
    const user = JSON.parse(localStorage.getItem('user') || '{}')
    await axios.delete(`/api/contract-templates/${id}`, {
      headers: { 'x-user-id': user.id || 0 }
    })
    ElMessage.success('删除成功')
    loadData()
  } catch (e) {
    if (e !== 'cancel') ElMessage.error(e?.response?.data?.message || '删除失败')
  }
}

// 初始化编辑器（在 setup 中同步调用，由 Tiptap 自动管理生命周期）
createNewEditor()

onMounted(() => {
  loadData()
  loadCustomVars()
})

onBeforeUnmount(() => {
  if (editor.value) {
    editor.value.destroy()
  }
})
</script>

