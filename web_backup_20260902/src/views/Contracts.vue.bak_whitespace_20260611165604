}

// HTML转docx（返回 paragraphs 和 tables 两个数组）
// paragraphs 用于普通段落，tables 用于表格（docx库要求表格直接放Document children）
function htmlToDocx(html, vars) {
  let content = html
  Object.keys(vars).forEach(key => {
    content = content.replace(new RegExp('\\{' + key + '\\}', 'g'), vars[key] || '')
  })
  const parser = new DOMParser()
  const doc = parser.parseFromString(content, 'text/html')
  const body = doc.body
  const paragraphs = []
  const tables = []

  // 遍历所有子节点
  Array.from(body.childNodes).forEach(node => {
    if (node.nodeType === 3) { // Text node
      const text = node.textContent
      if (text.trim()) {
        paragraphs.push(new Paragraph({
          children: [new TextRun({ text, font: 'SimSun' })],
          alignment: AlignmentType.JUSTIFIED,
          spacing: { line: 360 }
        }))
      }
    } else if (node.nodeType === 1) { // Element node
      const tag = node.tagName.toUpperCase()
      const clone = node.cloneNode(true)

      // 分页符
      if (tag === 'HR') {
        paragraphs.push(new Paragraph({
          children: [new TextRun({ text: '' })],
          pageBreakBefore: true
        }))
        return
      }

      // 表格
      if (tag === 'TABLE') {
        const rows = clone.querySelectorAll('tr')
        const docxRows = []
        rows.forEach(row => {
          const cells = row.querySelectorAll('td, th')
          const docxCells = Array.from(cells).map(cell => {
            const cellText = cell.textContent.trim()
            const isHeader = cell.tagName.toUpperCase() === 'TH'
            return new DocxTableCell({
              children: [new Paragraph({
                children: [new TextRun({
                  text: cellText,
                  font: 'SimSun',
                  bold: isHeader
                })],
                alignment: AlignmentType.CENTER,
                spacing: { line: 280 }
              })],
              shading: isHeader ? { fill: 'F5F5F5', type: ShadingType.CLEAR } : undefined,
              borders: {
                top: { style: BorderStyle.SINGLE, size: 4, color: '333333' },
                bottom: { style: BorderStyle.SINGLE, size: 4, color: '333333' },
                left: { style: BorderStyle.SINGLE, size: 4, color: '333333' },
                right: { style: BorderStyle.SINGLE, size: 4, color: '333333' }
              }
            })
          })
          docxRows.push(new DocxTableRow({ children: docxCells }))
        })
        tables.push(new DocxTable({
          rows: docxRows,
          width: { size: 100, type: WidthType.PERCENTAGE },
          borders: {
            top: { style: BorderStyle.SINGLE, size: 4, color: '333333' },
            bottom: { style: BorderStyle.SINGLE, size: 4, color: '333333' },
            left: { style: BorderStyle.SINGLE, size: 4, color: '333333' },
            right: { style: BorderStyle.SINGLE, size: 4, color: '333333' },
            insideH: { style: BorderStyle.SINGLE, size: 4, color: '333333' },
            insideV: { style: BorderStyle.SINGLE, size: 4, color: '333333' }
          }
        }))
        return
      }

      // 标题
      if (/^H[1-6]$/.test(tag)) {
        const level = parseInt(tag[1])
        const text = clone.textContent.trim()
        const align = clone.style.textAlign || 'center'
        paragraphs.push(new Paragraph({
          children: [new TextRun({ text, font: 'SimSun', bold: true, size: 28 - (level - 1) * 2 })],
          heading: level === 1 ? HeadingLevel.HEADING_1 : level === 2 ? HeadingLevel.HEADING_2 : HeadingLevel.HEADING_3,
          alignment: align === 'center' ? AlignmentType.CENTER : align === 'right' ? AlignmentType.RIGHT : AlignmentType.JUSTIFIED,
          spacing: { before: 240, after: 120 }
        }))
        return
      }

      // 列表项
      if (tag === 'LI') {
        const text = clone.textContent.trim()
        paragraphs.push(new Paragraph({
          children: [new TextRun({ text, font: 'SimSun' })],
          alignment: AlignmentType.JUSTIFIED,
          indent: { left: convertInchesToTwip(0.3) },
          spacing: { line: 360 }
        }))
        return
      }

      // 引用
      if (tag === 'BLOCKQUOTE') {
        const text = clone.textContent.trim()
        paragraphs.push(new Paragraph({
          children: [new TextRun({ text, font: 'SimSun', color: '666666' })],
          alignment: AlignmentType.JUSTIFIED,
          indent: { left: convertInchesToTwip(0.5) },
          border: { left: { style: BorderStyle.SINGLE, size: 12, color: '409EFF' } },
          spacing: { line: 360 }
        }))
        return
      }

      // 普通段落
      if (['P', 'DIV'].includes(tag)) {
        const text = clone.textContent.trim()
        if (!text) return
        const align = clone.style.textAlign || 'justify'
        paragraphs.push(new Paragraph({
          children: [new TextRun({ text, font: 'SimSun' })],
          alignment: align === 'center' ? AlignmentType.CENTER : align === 'right' ? AlignmentType.RIGHT : AlignmentType.JUSTIFIED,
          spacing: { line: 360 },
          indent: { firstLine: convertInchesToTwip(0.3) }
        }))
      }
    }
  })

  if (paragraphs.length === 0) {
    paragraphs.push(new Paragraph({ children: [new TextRun({ text: '' })] }))
  }
  return { paragraphs, tables }
}

