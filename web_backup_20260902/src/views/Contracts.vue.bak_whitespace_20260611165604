const MM_TO_PX = 96 / 25.4
const A4_WIDTH_PX = Math.round(210 * MM_TO_PX)
const A4_HEIGHT_PX = Math.round(297 * MM_TO_PX)
const PAGE_HORIZONTAL_PADDING_PX = Math.round(20 * MM_TO_PX)
const PREVIEW_BODY_TOP_PX = Math.round(28 * MM_TO_PX)
const PREVIEW_BODY_BOTTOM_PX = Math.round(22 * MM_TO_PX)

// PDF body 内容区高度（不用 preview 的 top/bottom 直接换算）
// PDF .page flex: column → header=12mm + body(flex:1) + footer=12mm
// .body { padding:8mm 20mm } → 内容区 = 297mm - 12*2 - 8*2 = 257mm = 973px
// 减去 20mm(76px) 安全余量，避免 estimateHeight 估算误差导致溢出到页脚
// 最终 BODY_HEIGHT_PX = 973 - 76 = 897px ≈ 237mm，内容高度低于 PDF body 实际可用
// 这样即使 estimateHeight 有 5-10% 误差（如 line-height/字体渲染差异），也有足够余量
const PDF_BODY_CONTENT_PX = Math.round(297 * MM_TO_PX) - 2 * Math.round(12 * MM_TO_PX) - 2 * Math.round(8 * MM_TO_PX)
const SAFETY_PX = Math.round(20 * MM_TO_PX)
const BODY_HEIGHT_PX = PDF_BODY_CONTENT_PX - SAFETY_PX

// 把 HTML 内容分成多页
const computePageBreaks = (html) => {
  if (!html || html === '<p></p>' || html === '<p><br></p>') return ['']

  // 用 DOM 解析内容（若数据库存有历史遗留的 w:/o: 前缀内容，
  // DOMParser 会保留前缀，serializeToString 后仍带前缀导致预览消失，在此再清一遍保险）
  const cleanHtml = html
    .replace(/<\/?o:[^>]+>/gi, '')
    .replace(/<\/?w:[^>]+>/gi, '')
    .replace(/<\/?m:[^>]+>/gi, '')
    .replace(/<\/?v:[^>]+>/gi, '')
  const parser = new DOMParser()
  const doc = parser.parseFromString(cleanHtml, 'text/html')
  const body = doc.body

  const pages = []
  let currentPage = ''
  let currentHeight = 0

  // 遍历所有子节点
  const children = Array.from(body.childNodes)

  const estimateHeight = (el) => {
    const clone = el.cloneNode(true)
    // table 用 position:absolute 会导致高度计算为0，改用 static 定位
    if (clone.tagName !== 'TABLE') {
      clone.style.position = 'absolute'
    }
    clone.style.visibility = 'hidden'
    clone.style.width = (A4_WIDTH_PX - PAGE_HORIZONTAL_PADDING_PX * 2) + 'px'
    clone.style.whiteSpace = 'pre-wrap'
    clone.style.wordBreak = 'break-word'
    // 使用与 CSS .a4-body 和 PDF body-wrap 完全一致的字体参数（12pt ≈ 16px at 96dpi）
    clone.style.font = '16px SimSun, Microsoft YaHei, serif'
    clone.style.lineHeight = '1.8'
    // 匹配 .body-wrap 的 text-align:justify
    clone.style.textAlign = 'justify'
    document.body.appendChild(clone)
    const h = clone.offsetHeight
    document.body.removeChild(clone)
    return h
  }

  for (const child of children) {
    if (child.nodeType === 3) { // Text node
      const text = child.textContent
      if (!text.trim()) continue
      const span = document.createElement('span')
      span.textContent = text
      const p = document.createElement('p')
      p.appendChild(span)
      const h = estimateHeight(p)
      if (currentHeight + h > BODY_HEIGHT_PX && currentHeight > 0) {
        pages.push(currentPage)
        currentPage = ''
        currentHeight = 0
      }
      currentPage += child.textContent
      currentHeight += h
    } else if (child.nodeType === 1) { // Element node
      const clone = child.cloneNode(true)
      // 去掉分页符元素
      if (clone.tagName === 'HR') {
        if (currentHeight > 0) {
          pages.push(currentPage)
          currentPage = ''
          currentHeight = 0
        }
        continue
      }
      const h = estimateHeight(clone)
      if (currentHeight + h > BODY_HEIGHT_PX && currentHeight > 0) {
        pages.push(currentPage)
        currentPage = ''
        currentHeight = 0
      }
      currentPage += new XMLSerializer().serializeToString(child)
      currentHeight += h
    }
  }

  if (currentPage || currentHeight > 0) {
    pages.push(currentPage)
  }

  return pages.length > 0 ? pages : ['']
}

