// 把正文HTML中所有 {name} 和 {=name} 占位符替换为实际值（纯字符串替换，用于编辑前预处理）
const replaceAllVarsInRawContent = (html) => {
  if (!html) return html
  // 1. 替换普通变量 {name}
  const allVars = [...builtInVariables, ...customVariables.value]
  for (const v of allVars) {
    const val = varForm[v.name]
    if (!val) continue
    const placeholder = `{${v.name}}`
    if (html.includes(placeholder)) {
      html = html.split(placeholder).join(val)
    }
  }
  // 2. 替换计算变量 {=varname}（用计算后的值）
  for (const cv of computedVarList.value) {
    const val = getComputedVarValue(cv)
    if (!val) continue
    const placeholder = `{=${cv.name}}`
    if (html.includes(placeholder)) {
      html = html.split(placeholder).join(val)
    }
  }
  return html
}

