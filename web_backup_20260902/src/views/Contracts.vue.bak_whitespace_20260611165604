      <el-form :model="editingVar" label-width="80px">
        <el-form-item v-if="isBuiltInVar" label="变量名">
          <el-input v-model="editingVar.name" disabled />
        </el-form-item>
        <el-form-item label="变量名">
          <el-input v-model="editingVar.label" :placeholder="isBuiltInVar ? editingVar.label : '请输入变量名'" :disabled="isBuiltInVar" />
        </el-form-item>
        <el-form-item label="数值"><el-input v-model="editingVar.value" placeholder="请输入数值" /></el-form-item>
      </el-form>
