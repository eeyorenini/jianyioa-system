// 导出PDF - 使用 Puppeteer 后端渲染
const exportPdf = async (row) => {
  try {
    isExporting.value = true

    const categoryName = categoryMap[row.category] || '装修合同'
    let content = row.content || ''

    // 替换变量
    let processedContent = content
    Object.keys(row).forEach(key => {
      processedContent = processedContent.replace(new RegExp('\\{' + key + '\\}', 'g'), row[key] || '')
    })

    // 用预览模式的分页算法计算分页
    const pages = computePageBreaks(processedContent)
    const total = pages.length

    // 构建多页PDF数据，每页包含完整header+body+footer
    const pdfPages = pages.map((bodyHtml, idx) => ({
      html: buildPdfPageHtml(bodyHtml, row.contract_no, categoryName, idx + 1, total)
