    .replace(/[^a-zA-Z0-9\u4e00-\u9fa5]/g, '_')
    .replace(/([A-Z])/g, '_$1')
    .toLowerCase()
    .replace(/\u4e00-\u9fa5/g, (ch) => ch.charCodeAt(0).toString(16))
    .replace(/_0x/g, '_')
  if (computedVarList.value.some(v => v.name === generatedName)) return ElMessage.warning('变量名已存在')
  computedVarList.value.push({ name: generatedName, label: newComputedVar.label, type: newComputedVar.type, sourceVar: newComputedVar.sourceVar, ratio: newComputedVar.ratio })
