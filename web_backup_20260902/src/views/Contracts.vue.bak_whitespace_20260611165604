// 获取计算变量的值
const getComputedVarValue = (cv) => {
  const sourceVal = varForm[cv.sourceVar]
  if (!sourceVal) return ''
  const num = parseFloat(sourceVal)
  if (isNaN(num)) return ''
  if (cv.type === 'upper') {
    return toChineseMoney(num)
  } else if (cv.type === 'ratio') {
    const ratioNum = parseFloat(cv.ratio)
    if (isNaN(ratioNum)) return ''
    return (num * ratioNum / 100).toFixed(2)
  }
  return ''
}

// 数字转中文大写金额
import { numberToCurrency } from 'chinese-number-format'
const toChineseMoney = (num) => {
  if (isNaN(num) || num === null || num === undefined) return ''
  return numberToCurrency(num, { locale: 'zh-CN' })
}

