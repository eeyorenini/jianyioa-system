// 处理图片上传
const handleImageUpload = async (e) => {
  const file = e.target.files?.[0]
  if (!file || !editor.value) return
  uploadLoading.value = true
  uploadLoadingText.value = '正在导入图片...'
  try {
    const formData = new FormData()
    formData.append('file', file)
    const { data } = await axios.post('/api/upload-image', formData, {
      headers: { 'Content-Type': 'multipart/form-data' }
    })
    if (data.url) {
      editor.value.chain().focus().setImage({ src: data.url }).run()
      ElMessage.success('图片插入成功')
    } else {
      ElMessage.error(data.error || '图片上传失败')
    }
  } catch (err) {
    ElMessage.error('图片上传失败')
  } finally {
    uploadLoading.value = false
    e.target.value = ''
  }
}

// 处理PDF上传（转成多页预览图后一次性插入）
const handlePdfUpload = async (e) => {
  const file = e.target.files?.[0]
  if (!file || !editor.value) return
  uploadLoading.value = true
  uploadLoadingText.value = '正在导入PDF...'
  try {
    const formData = new FormData()
    formData.append('file', file)
    const { data } = await axios.post('/api/upload-pdf', formData, {
      headers: { 'Content-Type': 'multipart/form-data' }
    })
    if (data.urls && data.urls.length) {
      // 一次性插入所有页面图片，用 insertContent 一次事务完成
      uploadLoadingText.value = `正在插入 ${data.urls.length} 页...`
      const imageNodes = data.urls.map(url => ({
        type: 'image',
        attrs: { src: url }
      }))
      editor.value.chain().focus().insertContent(imageNodes).run()
      ElMessage.success(`PDF 插入成功（共 ${data.urls.length} 页）`)
    } else {
      ElMessage.error(data.error || 'PDF 处理失败')
    }
  } catch (err) {
    ElMessage.error('PDF 处理失败')
  } finally {
    uploadLoading.value = false
    e.target.value = ''
  }
}

// 插入变量：直接插入实际值
const insertVar = (v) => {
  if (!editor.value) { ElMessage.warning('编辑器未就绪'); return }
  try {
    const val = varForm[v.name] || ''
    const { from } = editor.value.state.selection
    editor.value.chain().focus().insertContent(val).run()
  } catch (e) {
    console.error('插入变量失败:', e)
  }
}

