const showImportTemplate = () => { selectedTemplateId.value = null; loadTemplates(); showImportDialog.value = true }

// 从模板内容中解析出所有 {变量名} 占位符
const parseVarsFromContent = (html) => {
  const matches = html.match(/\{(\w+)\}/g) || []
  return [...new Set(matches.map(m => m.slice(1, -1)))]
}

const doImportTemplate = async () => {
  if (!selectedTemplateId.value) { ElMessage.warning('请选择模板'); return }
  const template = templateList.value.find(t => t.id === selectedTemplateId.value)
  if (!template) { ElMessage.error('模板不存在'); return }

  // 0. 解析模板中的自定义变量和计算变量
  let templateCustomVars = [] // [{name, label}]
  let templateComputedVars = []
  if (template.template_fields) {
    try {
      const templateFieldsRaw = template.template_fields
      const templateFields = typeof templateFieldsRaw === 'string' ? JSON.parse(templateFieldsRaw) : templateFieldsRaw
      if (templateFields.vars && Array.isArray(templateFields.vars)) {
        templateCustomVars = templateFields.vars.filter(v => v.name && v.label)
      } else if (Array.isArray(templateFields) && templateFields.length > 0) {
        templateCustomVars = templateFields.filter(v => v.name && v.label)
      }
      if (templateFields.computed && Array.isArray(templateFields.computed)) {
        templateComputedVars = templateFields.computed.filter(cv => cv.name && cv.label)
      }
    } catch (e) {
      console.error('解析template_fields失败', e)
    }
  }
  // 如果模板没有自定义变量，但从内容中解析
  if (templateCustomVars.length === 0) {
    const contentVarNames = parseVarsFromContent(template.content || '')
    const builtInNames = builtInVariables.map(bv => bv.name)
    for (const name of contentVarNames) {
      if (!builtInNames.includes(name)) {
        templateCustomVars.push({ name, label: name })
      }
    }
  }

  // 1. 导入内容（编辑器内容直接替换为模板）
  editor.value?.commands.setContent(template.content || '<p></p>')

  // 2. 内置变量：保留 varForm 现有值，不初始化
  // 3. 自定义变量：以模板为准
  const currentCustomVarNames = customVariables.value.map(v => v.name)
  const templateCustomVarNames = templateCustomVars.map(v => v.name)
  // 检查是否不一致
  const currentSet = new Set(currentCustomVarNames)
  const templateSet = new Set(templateCustomVarNames)
  let hasInconsistency = currentCustomVarNames.length !== templateCustomVarNames.length ||
    currentCustomVarNames.some(n => !templateSet.has(n)) ||
    templateCustomVarNames.some(n => !currentSet.has(n))

  if (hasInconsistency) {
    // 有不一致，弹框让用户选择
    try {
      await ElMessageBox.confirm(
        '当前内容变量与模板不一致，是否删除内容中的变量并使用模板变量？\n\n选择"是"：删除内容中所有自定义变量，以模板为准\n选择"否"：保留当前内容变量，同时显示模板变量',
        '变量不一致',
        {
          confirmButtonText: '是（删除并以模板为准）',
          cancelButtonText: '否（合并两者）',
          type: 'warning',
          distinguishCancelAndClose: true
        }
      )
      // 用户选择"是"：以模板为准，完全替换
      customVariables.value = templateCustomVars.map(v => ({ name: v.name, label: v.label }))
      // 只清空模板中不存在的自定义变量对应的 varForm 字段（保留内置变量和其他字段）
      Object.keys(varForm).forEach(k => {
        if (!builtInVariables.some(bv => bv.name === k) &&
            !['contract_no','status','customer_name','customer_phone','id_card','total_amount','content'].includes(k) &&
            !templateCustomVarNames.includes(k)) {
          delete varForm[k]
        }
      })
      // 模板中的变量在 varForm 中没值的设为空，有值的保留
      templateCustomVarNames.forEach(name => {
        if (varForm[name] === undefined) varForm[name] = ''
      })
      ElMessage.success('模板导入成功，已以模板变量为准')
    } catch (e) {
      // 用户选择"否"或关闭：合并两者
      // 把模板中不在当前列表里的变量追加进来，保留当前已有的值
      for (const v of templateCustomVars) {
        if (!currentSet.has(v.name)) {
          customVariables.value.push({ name: v.name, label: v.label })
          if (varForm[v.name] === undefined) varForm[v.name] = ''
        }
      }
      ElMessage.success('模板导入成功，已合并当前变量与模板变量')
    }
  } else {
    // 变量一致，什么都不动，只保留当前值
    ElMessage.success('模板导入成功，变量无变化')
  }

  // 4. 计算变量：以模板为准，完全替换
  computedVarList.value = templateComputedVars.map(cv => ({
    name: cv.name,
    label: cv.label,
    type: cv.type || 'upper',
    sourceVar: cv.sourceVar || '',
    ratio: cv.ratio || ''
  }))

  showImportDialog.value = false

  // 5. 导入后立即把 {变量名} 占位符替换为实际填写值
  nextTick(() => replaceAllVarsInContent())
}

// 把正文所有 {变量名} 占位符替换为实际填写的值（支持内置、自定义、计算变量）
const replaceAllVarsInContent = () => {
  if (!editor.value) return
  const allVars = [...builtInVariables, ...customVariables.value]
  // 1. 先替换普通变量 {name}
  for (const v of allVars) {
    const val = varForm[v.name]
    if (!val) continue
    const placeholder = `{${v.name}}`
    const html = editor.value.getHTML()
    if (html.includes(placeholder)) {
      const newHtml = html.split(placeholder).join(val)
      editor.value.commands.setContent(newHtml)
    }
  }
  // 2. 再替换计算变量 {=varname}（用计算后的值）
  for (const cv of computedVarList.value) {
    const val = getComputedVarValue(cv)
    if (!val) continue
    const placeholder = `{=${cv.name}}`
    const html = editor.value.getHTML()
    if (html.includes(placeholder)) {
      const newHtml = html.split(placeholder).join(val)
      editor.value.commands.setContent(newHtml)
    }
  }
}

