const doSaveTemplate = async () => {
  if (!templateForm.name) { ElMessage.warning('请输入模板名称'); return }
  try {
    const user = JSON.parse(localStorage.getItem('user') || '{}')
    // 把当前自定义变量（name+label）和计算变量一起序列化存入 template_fields
    const varsToSave = customVariables.value.map(v => ({ name: v.name, label: v.label }))
    const computedToSave = computedVarList.value.map(cv => ({ name: cv.name, label: cv.label, type: cv.type, sourceVar: cv.sourceVar, ratio: cv.ratio }))
    // 从编辑器获取内容，把 data-var span 替换回 {varname} 再保存
    let templateContent = editor.value?.getHTML() || templateSourceContent.value || ''
    // 替换 <span data-var="varname">实际值</span> 为 {varname}
    templateContent = templateContent.replace(/<span data-var="([^"]+)">[^<]*<\/span>/g, '{$1}')
    await axios.post('/api/contract-templates', {
      name: templateForm.name, category: templateForm.category, template_type: templateForm.template_type,
      content: templateContent,
      template_fields: JSON.stringify({ vars: varsToSave, computed: computedToSave }),
      user_id: user.id || 0
    }, { headers: { 'x-user-id': user.id || 0 } })
    ElMessage.success('模板保存成功')
    showTemplateDialog.value = false
    loadTemplates()
  } catch (e) {
    const errMsg = e?.response?.data?.message || e?.response?.data?.error || e.message || '保存失败'
    ElMessage.error('模板保存失败: ' + errMsg)
    console.error('模板保存失败:', e?.response || e)
  }
}

