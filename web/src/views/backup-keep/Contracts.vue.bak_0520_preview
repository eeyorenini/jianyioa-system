// HTML转docx段落
function htmlToDocx(html, vars) {
  let content = html
  Object.keys(vars).forEach(key => {
    content = content.replace(new RegExp('\\{' + key + '\\}', 'g'), vars[key] || '')
  })
  const parser = new DOMParser()
  const doc = parser.parseFromString(content, 'text/html')
  const paragraphs = []
  doc.querySelectorAll('p, h1, h2, h3, h4, li, div').forEach(el => {
    if (el.children.length > 0) return
    const text = el.textContent.trim()
    if (!text) return
    const p = new Paragraph({
      children: [new TextRun({ text, font: 'Microsoft YaHei' })],
      heading: el.tagName.match(/^H1$/) ? HeadingLevel.HEADING_1 : el.tagName.match(/^H[234]$/) ? HeadingLevel.HEADING_2 : undefined,
      alignment: el.style.textAlign === 'center' ? AlignmentType.CENTER : el.style.textAlign === 'right' ? AlignmentType.RIGHT : AlignmentType.JUSTIFIED
    })
    paragraphs.push(p)
  })
  if (paragraphs.length === 0) {
    paragraphs.push(new Paragraph({ children: [new TextRun({ text: '' })] }))
  }
  return paragraphs
}

