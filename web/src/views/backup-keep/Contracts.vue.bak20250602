const generateContractNo = () => {
  const date = new Date()
  const dateStr = date.toISOString().slice(0,10).replace(/-/g,'')
  const random = String(Math.floor(Math.random() * 1000)).padStart(3,'0')
  return 'HT-' + dateStr + '-' + random
}

const loadCustomVars = async () => {
  try {
    const res = await axios.get('/api/contract-variables')
    customVariables.value = res.data || []
  } catch (e) { console.error('加载变量失败:', e) }
}

const addCustomVar = async () => {
  if (!newCustomVar.name || !newCustomVar.label) return ElMessage.warning('请填写完整')
  if (allVariables.value.some(v => v.name === newCustomVar.name)) return ElMessage.warning('变量名已存在')
  try {
    const res = await axios.post('/api/contract-variables', {
      name: newCustomVar.name,
      label: newCustomVar.label
    })
    if (res.data.success) {
      customVariables.value.push({ id: res.data.id, name: newCustomVar.name, label: newCustomVar.label })
      varForm[newCustomVar.name] = ''
      newCustomVar.name = ''
      newCustomVar.label = ''
      showAddCustomVarDialog.value = false
      ElMessage.success('添加成功')
    }
  } catch (e) { ElMessage.error('添加失败') }
}

const removeCustomVar = async (varItem) => {
  if (!varItem.id) { ElMessage.error('无法删除内置变量或ID不存在'); return }
  try {
    await axios.delete('/api/contract-variables/' + varItem.id)
    const idx = customVariables.value.findIndex(v => v.id === varItem.id)
    if (idx >= 0) {
      const name = customVariables.value[idx].name
      customVariables.value.splice(idx, 1)
      delete varForm[name]
    }
    ElMessage.success('删除成功')
  } catch (e) { ElMessage.error('删除失败') }
}

const openAddCustomVar = () => {
  newCustomVar.name = ''
  newCustomVar.label = ''
  showAddCustomVarDialog.value = true
}

