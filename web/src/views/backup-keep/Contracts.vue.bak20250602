const exportCurrentWord = async () => {
  try {
    ElMessage.info('正在生成Word文档，请稍候...')
    const content = editor.value?.getHTML() || ''
    // 替换变量
    let processedContent = content
    Object.keys(varForm).forEach(key => {
      processedContent = processedContent.replace(new RegExp('\\{' + key + '\\}', 'g'), varForm[key] || '')
    })
    // 用预览模式的分页算法分页
    const pages = computePageBreaks(processedContent)
    const total = pages.length

    // 构建多页内容，每页独立处理
    const allChildren = []
    for (let i = 0; i < pages.length; i++) {
      if (i > 0) {
        // 分页符段落 - 每个新页面开始前插入分页符
        allChildren.push(new Paragraph({ children: [new TextRun({ text: '' })], pageBreakBefore: true }))
      }
      const pageResult = htmlToDocx(pages[i], {})
      // 按正确顺序交替添加段落和表格（表格必须和段落交错，不能统一放最后）
      for (let j = 0; j < pageResult.paragraphs.length; j++) {
        allChildren.push(pageResult.paragraphs[j])
        if (pageResult.tables[j]) {
          allChildren.push(pageResult.tables[j])
        }
      }
      // 如果段落数少于表格数，补充剩余表格（理论上不应发生）
      if (pageResult.paragraphs.length < pageResult.tables.length) {
        for (let k = pageResult.paragraphs.length; k < pageResult.tables.length; k++) {
          allChildren.push(pageResult.tables[k])
        }
      }
    }

    const doc = new Document({
      sections: [{
        properties: {
          page: {
            size: { width: convertInchesToTwip(8.27), height: convertInchesToTwip(11.69) },
            margin: { top: convertInchesToTwip(0.79), right: convertInchesToTwip(0.79), bottom: convertInchesToTwip(0.79), left: convertInchesToTwip(0.79) }
          }
        },
        headers: {
          default: new Header({
            children: [
              new Paragraph({
                children: [
                  new TextRun({ text: `简逸装饰 | ${varForm.contract_no || ''} | ${categoryMap[varForm.category] || '装修合同'}`, font: 'SimSun', size: 18, color: '999999' })
                ],
                alignment: AlignmentType.CENTER,
                border: { bottom: { style: BorderStyle.SINGLE, size: 6, color: 'CCCCCC' } },
                spacing: { after: 120 }
              })
            ]
          })
        },
        footers: {
          default: new Footer({
            children: [
              new Paragraph({
                children: [
                  new TextRun({ text: `第 ${1} / ${total} 页`, font: 'SimSun', size: 18, color: '999999' })
                ],
                alignment: AlignmentType.CENTER,
                border: { top: { style: BorderStyle.SINGLE, size: 6, color: 'CCCCCC' } },
                spacing: { before: 120 }
              })
            ]
          })
        },
        children: allChildren
      }]
    })
    const blob = await Packer.toBlob(doc)
    saveAs(blob, '合同_' + (varForm.contract_no || Date.now()) + '.docx')
    ElMessage.success('Word文档导出成功')
  } catch (e) {
    ElMessage.error('导出Word失败: ' + e.message)
    console.error('导出Word详细错误:', e)
  }
}

// HTML转docx（返回 paragraphs 和 tables 两个数组）
// paragraphs 用于普通段落，tables 用于表格（docx库要求表格直接放Document children）
function htmlToDocx(html, vars) {
  let content = html
  Object.keys(vars).forEach(key => {
    content = content.replace(new RegExp('\\{' + key + '\\}', 'g'), vars[key] || '')
  })
  const parser = new DOMParser()
  const doc = parser.parseFromString(content, 'text/html')
  const body = doc.body
  const paragraphs = []
  const tables = []

  // 遍历所有子节点
  Array.from(body.childNodes).forEach(node => {
    if (node.nodeType === 3) { // Text node
      const text = node.textContent
      if (text.trim()) {
        paragraphs.push(new Paragraph({
          children: [new TextRun({ text, font: 'SimSun' })],
          alignment: AlignmentType.JUSTIFIED,
          spacing: { line: 360 }
        }))
      }
    } else if (node.nodeType === 1) { // Element node
      const tag = node.tagName.toUpperCase()
      const clone = node.cloneNode(true)

      // 分页符
      if (tag === 'HR') {
        paragraphs.push(new Paragraph({
          children: [new TextRun({ text: '' })],
          pageBreakBefore: true
        }))
        return
      }

      // 表格
      if (tag === 'TABLE') {
        const rows = clone.querySelectorAll('tr')
        const docxRows = []
        rows.forEach(row => {
          const cells = row.querySelectorAll('td, th')
          const docxCells = Array.from(cells).map(cell => {
            const cellText = cell.textContent.trim()
            const isHeader = cell.tagName.toUpperCase() === 'TH'
            return new DocxTableCell({
              children: [new Paragraph({
                children: [new TextRun({
                  text: cellText,
                  font: 'SimSun',
                  bold: isHeader
                })],
                alignment: AlignmentType.CENTER,
                spacing: { line: 280 }
              })],
              shading: isHeader ? { fill: 'F5F5F5', type: ShadingType.CLEAR } : undefined,
              borders: {
                top: { style: BorderStyle.SINGLE, size: 4, color: '333333' },
                bottom: { style: BorderStyle.SINGLE, size: 4, color: '333333' },
                left: { style: BorderStyle.SINGLE, size: 4, color: '333333' },
                right: { style: BorderStyle.SINGLE, size: 4, color: '333333' }
              }
            })
          })
          docxRows.push(new DocxTableRow({ children: docxCells }))
        })
        tables.push(new DocxTable({
          rows: docxRows,
          width: { size: 100, type: WidthType.PERCENTAGE },
          borders: {
            top: { style: BorderStyle.SINGLE, size: 4, color: '333333' },
            bottom: { style: BorderStyle.SINGLE, size: 4, color: '333333' },
            left: { style: BorderStyle.SINGLE, size: 4, color: '333333' },
            right: { style: BorderStyle.SINGLE, size: 4, color: '333333' },
            insideH: { style: BorderStyle.SINGLE, size: 4, color: '333333' },
            insideV: { style: BorderStyle.SINGLE, size: 4, color: '333333' }
          }
        }))
        return
      }

      // 标题
      if (/^H[1-6]$/.test(tag)) {
        const level = parseInt(tag[1])
        const text = clone.textContent.trim()
        const align = clone.style.textAlign || 'center'
        paragraphs.push(new Paragraph({
          children: [new TextRun({ text, font: 'SimSun', bold: true, size: 28 - (level - 1) * 2 })],
          heading: level === 1 ? HeadingLevel.HEADING_1 : level === 2 ? HeadingLevel.HEADING_2 : HeadingLevel.HEADING_3,
          alignment: align === 'center' ? AlignmentType.CENTER : align === 'right' ? AlignmentType.RIGHT : AlignmentType.JUSTIFIED,
          spacing: { before: 240, after: 120 }
        }))
        return
      }

      // 列表项
      if (tag === 'LI') {
        const text = clone.textContent.trim()
        paragraphs.push(new Paragraph({
          children: [new TextRun({ text, font: 'SimSun' })],
          alignment: AlignmentType.JUSTIFIED,
          indent: { left: convertInchesToTwip(0.3) },
          spacing: { line: 360 }
        }))
        return
      }

      // 引用
      if (tag === 'BLOCKQUOTE') {
        const text = clone.textContent.trim()
        paragraphs.push(new Paragraph({
          children: [new TextRun({ text, font: 'SimSun', color: '666666' })],
          alignment: AlignmentType.JUSTIFIED,
          indent: { left: convertInchesToTwip(0.5) },
          border: { left: { style: BorderStyle.SINGLE, size: 12, color: '409EFF' } },
          spacing: { line: 360 }
        }))
        return
      }

      // 普通段落
      if (['P', 'DIV'].includes(tag)) {
        const text = clone.textContent.trim()
        if (!text) return
        const align = clone.style.textAlign || 'justify'
        paragraphs.push(new Paragraph({
          children: [new TextRun({ text, font: 'SimSun' })],
          alignment: align === 'center' ? AlignmentType.CENTER : align === 'right' ? AlignmentType.RIGHT : AlignmentType.JUSTIFIED,
          spacing: { line: 360 },
          indent: { firstLine: convertInchesToTwip(0.3) }
        }))
      }
    }
  })

  if (paragraphs.length === 0) {
    paragraphs.push(new Paragraph({ children: [new TextRun({ text: '' })] }))
  }
  return { paragraphs, tables }
}

const showSaveTemplateFromContent = () => {
  templateSourceContent.value = editor.value?.getHTML() || ''
  templateForm.name = varForm.contract_no + '模板'
  templateForm.category = 'decoration'
  templateForm.template_type = 'personal'
  showTemplateDialog.value = true
}

const doSaveTemplate = async () => {
  if (!templateForm.name) { ElMessage.warning('请输入模板名称'); return }
  try {
    const user = JSON.parse(localStorage.getItem('user') || '{}')
    await axios.post('/api/contract-templates', {
      name: templateForm.name, category: templateForm.category, template_type: templateForm.template_type,
      content: templateSourceContent.value, user_id: user.id || 0
    }, { headers: { 'x-user-id': user.id || 0 } })
    ElMessage.success('模板保存成功')
    showTemplateDialog.value = false
    loadTemplates()
  } catch (e) {
    const errMsg = e?.response?.data?.message || e?.response?.data?.error || e.message || '保存失败'
    ElMessage.error('保存模板失败: ' + errMsg)
    console.error('保存模板失败:', e?.response || e)
  }
}

const handleDelete = async (id) => {
  try {
    await ElMessageBox.confirm('确定删除?', '提示', { type: 'warning' })
    await axios.delete('/api/contracts/' + id)
    ElMessage.success('删除成功')
    loadContracts()
  } catch (e) {
    if (e !== 'cancel') {
      const errMsg = e?.response?.data?.message || e?.response?.data?.error || e.message || '删除失败'
      ElMessage.error('删除失败: ' + errMsg)
      console.error('删除失败:', e?.response || e)
    }
  }
}

const showImportTemplate = () => { selectedTemplateId.value = null; loadTemplates(); showImportDialog.value = true }

const doImportTemplate = () => {
  if (!selectedTemplateId.value) { ElMessage.warning('请选择模板'); return }
  const template = templateList.value.find(t => t.id === selectedTemplateId.value)
  if (!template) { ElMessage.error('模板不存在'); return }
  
  editor.value?.commands.setContent(template.content || '<p></p>')
  showImportDialog.value = false
  ElMessage.success('模板导入成功')
}

const insertLink = () => {
  const url = prompt('输入链接地址:')
  if (url) {
    editor.value?.chain().focus().setLink({ href: url }).run()
  }
}

const doInsertTable = () => {
  editor.value?.chain().focus().insertTable({ rows: 3, cols: 3, withHeaderRow: true }).run()
}

const insertVar = (v) => {
  editor.value?.chain().focus().insertContent(`{${v.name}}`).run()
}

onMounted(() => { loadContracts(); loadCustomVars() })
</script>

