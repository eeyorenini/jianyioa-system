<template>
  <div class="contracts-page">
    <el-card>
      <template #header>
        <div class="card-header">
          <span>合同管理</span>
          <el-button type="primary" @click="showNewContractDialog">
            <el-icon><Plus /></el-icon>新建合同
          </el-button>
        </div>
      </template>
      
      <div class="search-bar">
        <el-input v-model="searchKey" placeholder="搜索" style="width:200px" clearable @keyup.enter="loadContracts" />
        <el-button @click="loadContracts">搜索</el-button>
      </div>
      
      <el-table :data="contractList" style="width:100%;margin-top:15px" stripe>
        <el-table-column prop="contract_no" label="合同编号" width="150" />
        <el-table-column prop="customer_name" label="客户姓名" min-width="120" />
        <el-table-column prop="total_amount" label="金额" width="120" align="right">
          <template #default="{row}"><span class="amount">¥{{ row.total_amount }}</span></template>
        </el-table-column>
        <el-table-column prop="status" label="状态" width="100" align="center">
          <template #default="{row}">
            <el-tag :type="row.status === '进行中' ? 'primary' : row.status === '已完成' ? 'success' : 'info'" size="small">{{ row.status }}</el-tag>
          </template>
        </el-table-column>
        <el-table-column label="操作" width="280" align="center">
          <template #default="{row}">
            <div style="display:flex; gap:5px; justify-content:center; flex-wrap:nowrap;">
              <el-button size="small" type="primary" @click="editContent(row)">编辑内容</el-button>
              <el-button size="small" type="warning" @click="editVariables(row)">编辑变量</el-button>
              <el-button size="small" @click="exportPdf(row)">导出</el-button>
              <el-button size="small" type="danger" plain @click="handleDelete(row.id)">删除</el-button>
            </div>
          </template>
        </el-table-column>
      </el-table>
    </el-card>

    <!-- 新建合同 - 填写变量 -->
    <el-dialog v-model="showVarFillDialog" title="新建合同 - 填写变量" width="700px">
      <el-form :model="varForm" label-width="100px" :rules="varRules" ref="varFormRef">
        <el-row :gutter="20">
          <el-col :span="12">
            <el-form-item label="合同编号"><el-input v-model="varForm.contract_no" disabled /></el-form-item>
          </el-col>
          <el-col :span="12">
            <el-form-item label="状态">
              <el-select v-model="varForm.status" style="width:100%">
                <el-option label="进行中" value="进行中" /><el-option label="已完成" value="已完成" /><el-option label="已取消" value="已取消" />
              </el-select>
            </el-form-item>
          </el-col>
        </el-row>
        <el-row :gutter="20">
          <el-col :span="12">
            <el-form-item label="客户姓名" prop="customer_name"><el-input v-model="varForm.customer_name" placeholder="请输入客户姓名" /></el-form-item>
          </el-col>
          <el-col :span="12">
            <el-form-item label="客户电话" prop="customer_phone"><el-input v-model="varForm.customer_phone" placeholder="请输入联系电话" /></el-form-item>
          </el-col>
        </el-row>
        <el-row :gutter="20">
          <el-col :span="12">
            <el-form-item label="身份证号" prop="id_card"><el-input v-model="varForm.id_card" placeholder="请输入身份证号" /></el-form-item>
          </el-col>
          <el-col :span="12">
            <el-form-item label="合同金额" prop="total_amount"><el-input-number v-model="varForm.total_amount" :min="0" style="width:100%" /></el-form-item>
          </el-col>
        </el-row>
        <el-row :gutter="20">
          <el-col :span="24">
            <el-form-item label="施工地址" prop="engineering_address"><el-input v-model="varForm.engineering_address" type="textarea" :rows="2" placeholder="请输入施工地址" /></el-form-item>
          </el-col>
        </el-row>
        <el-row :gutter="20">
          <el-col :span="12">
            <el-form-item label="签订日期"><el-date-picker v-model="varForm.sign_date" type="date" value-format="YYYY-MM-DD" style="width:100%" /></el-form-item>
          </el-col>
          <el-col :span="12">
            <el-form-item label="项目名称"><el-input v-model="varForm.project_name" placeholder="请输入项目名称" /></el-form-item>
          </el-col>
        </el-row>
        <el-row :gutter="20">
          <el-col :span="12">
            <el-form-item label="开工日期"><el-date-picker v-model="varForm.start_date" type="date" value-format="YYYY-MM-DD" style="width:100%" /></el-form-item>
          </el-col>
          <el-col :span="12">
            <el-form-item label="竣工日期"><el-date-picker v-model="varForm.end_date" type="date" value-format="YYYY-MM-DD" style="width:100%" /></el-form-item>
          </el-col>
        </el-row>
        
        <template v-if="customVariables.length > 0">
          <el-divider content-position="left">自定义变量</el-divider>
          <el-row :gutter="20" v-for="cv in customVariables" :key="cv.name">
            <el-col :span="24">
              <el-form-item :label="cv.label"><el-input v-model="varForm[cv.name]" :placeholder="'请输入' + cv.label" /></el-form-item>
            </el-col>
          </el-row>
        </template>
        
        <el-divider content-position="left">管理自定义变量</el-divider>
        <div class="custom-var-list">
          <el-tag v-for="cv in customVariables" :key="cv.name" type="success" closable @close="removeCustomVar(cv)" style="margin:3px;">{{ cv.label }}</el-tag>
          <el-button size="small" type="primary" plain @click="openAddCustomVar">+ 添加</el-button>
        </div>
      </el-form>
      <template #footer>
        <el-button @click="showVarFillDialog=false">取消</el-button>
        <el-button type="primary" @click="saveContractVariables">保存并编辑内容</el-button>
      </template>
    </el-dialog>

    <!-- 编辑内容 -->
    <el-dialog v-model="showContentDialog" :title="'编辑内容 - ' + varForm.contract_no" width="95%" top="2vh" @opened="onDialogOpened">
      <div class="content-section">
        <!-- 顶部工具栏 -->
        <div class="editor-top-bar">
          <div class="var-insert">
            <span>插入变量：</span>
            <el-tag v-for="v in allVariables" :key="v.name" type="success" effect="plain" @mousedown.prevent="insertVar(v)" style="cursor:pointer;margin:2px;">{{ v.label }}</el-tag>
            <el-button size="small" type="primary" plain @click="openAddCustomVar">+自定义</el-button>
            <el-button size="small" @click="showImportTemplate">导入模板</el-button>
          </div>
          
          <div class="toolbar" v-if="editor">
            <el-button-group>
              <el-button size="small" :type="editor.isActive('bold') ? 'primary' : ''" @click="editor.chain().focus().toggleBold().run()"><b>B</b></el-button>
              <el-button size="small" :type="editor.isActive('italic') ? 'primary' : ''" @click="editor.chain().focus().toggleItalic().run()"><i>I</i></el-button>
              <el-button size="small" :type="editor.isActive('underline') ? 'primary' : ''" @click="editor.chain().focus().toggleUnderline().run()"><u>U</u></el-button>
              <el-button size="small" :type="editor.isActive('strike') ? 'primary' : ''" @click="editor.chain().focus().toggleStrike().run()"><s>S</s></el-button>
            </el-button-group>
            <el-button-group>
              <el-button size="small" :type="editor.isActive('heading', { level: 1 }) ? 'primary' : ''" @click="editor.chain().focus().toggleHeading({ level: 1 }).run()">H1</el-button>
              <el-button size="small" :type="editor.isActive('heading', { level: 2 }) ? 'primary' : ''" @click="editor.chain().focus().toggleHeading({ level: 2 }).run()">H2</el-button>
              <el-button size="small" :type="editor.isActive('heading', { level: 3 }) ? 'primary' : ''" @click="editor.chain().focus().toggleHeading({ level: 3 }).run()">H3</el-button>
            </el-button-group>
            <el-button-group>
              <el-button size="small" @click="editor.chain().focus().toggleBulletList().run()" :type="editor.isActive('bulletList') ? 'primary' : ''">•列表</el-button>
              <el-button size="small" @click="editor.chain().focus().toggleOrderedList().run()" :type="editor.isActive('orderedList') ? 'primary' : ''">1.列表</el-button>
            </el-button-group>
            <el-button-group>
              <el-button size="small" @click="editor.chain().focus().toggleBlockquote().run()" :type="editor.isActive('blockquote') ? 'primary' : ''">引用</el-button>
              <el-button size="small" @click="editor.chain().focus().toggleCode().run()" :type="editor.isActive('code') ? 'primary' : ''">代码</el-button>
              <el-button size="small" @click="editor.chain().focus().toggleCodeBlock().run()" :type="editor.isActive('codeBlock') ? 'primary' : ''">代码块</el-button>
            </el-button-group>
            <el-button-group>
              <el-button size="small" title="文字颜色" @click="showColorPicker = !showColorPicker">
                <span style="border-bottom:2px solid">A</span>
              </el-button>
              <el-color-picker v-model="textColor" size="small" @change="(c) => { editor.chain().focus().setColor(c).run(); showColorPicker=false }" v-if="showColorPicker" />
              <el-button size="small" title="背景色" @click="showBgColorPicker = !showBgColorPicker">
                <span style="background:#ff0;padding:0 2px">A</span>
              </el-button>
              <el-color-picker v-model="bgColor" size="small" @change="(c) => { editor.chain().focus().setHighlight(c).run(); showBgColorPicker=false }" v-if="showBgColorPicker" />
            </el-button-group>
            <el-button-group>
              <el-button size="small" @click="editor.chain().focus().setTextAlign('left').run()">左</el-button>
              <el-button size="small" @click="editor.chain().focus().setTextAlign('center').run()">中</el-button>
              <el-button size="small" @click="editor.chain().focus().setTextAlign('right').run()">右</el-button>
            </el-button-group>
            <el-button-group>
              <el-button size="small" @click="editor.chain().focus().setHorizontalRule().run()" title="分隔线">—</el-button>
              <el-button size="small" @click="setLink" :type="editor.isActive('link') ? 'primary' : ''" title="链接">链接</el-button>
              <el-button size="small" @click="insertPageBreak" title="分页符">⏏</el-button>
            </el-button-group>
            <el-button-group>
              <el-button size="small" @click="editor.chain().focus().undo().run()" :disabled="!editor.can().undo()">撤销</el-button>
              <el-button size="small" @click="editor.chain().focus().redo().run()" :disabled="!editor.can().redo()">重做</el-button>
            </el-button-group>
          </div>
        </div>
        
        <!-- 模式切换：编辑 / 预览 -->
        <div class="preview-toggle">
          <el-radio-group v-model="editorMode" size="small" @change="setEditorMode">
            <el-radio-button label="edit" value="edit" @click="setEditorMode('edit')">编辑模式</el-radio-button>
            <el-radio-button label="preview" value="preview" @click="setEditorMode('preview')">预览模式（分页）</el-radio-button>
          </el-radio-group>
        </div>

        <!-- 编辑模式 -->
        <div v-if="editorMode === 'edit'" class="editor-container">
          <editor-content :editor="editor" class="editor-content" />
        </div>

        <!-- 预览模式：多页A4 -->
        <div v-if="editorMode === 'preview'" class="preview-container">
          <div class="preview-pages">
            <div
              v-for="(pageHtml, idx) in pageBreaks"
              :key="idx"
              class="a4-page"
            >
              <div class="a4-header">
                <span>简逸装饰 | {{ varForm.contract_no || '' }} | {{ contentCategoryName }}</span>
              </div>
              <div class="a4-body" v-html="pageHtml"></div>
              <div class="a4-footer">
                <span>第 {{ idx + 1 }} 页 / 共 {{ pageBreaks.length }} 页</span>
              </div>
            </div>
          </div>
        </div>
      </div>
      <template #footer>
        <el-button @click="showContentDialog=false">取消</el-button>
        <el-button @click="showSaveTemplateFromContent">保存模板</el-button>
        <el-button @click="exportCurrentPdf">导出PDF</el-button>
        <el-button @click="exportCurrentWord">导出Word</el-button>
        <el-button type="primary" @click="saveContent">保存内容</el-button>
      </template>
    </el-dialog>

    <!-- 编辑变量 -->
    <el-dialog v-model="showVarDialog" title="编辑变量" width="700px">
      <el-form :model="varForm" label-width="100px">
        <el-row :gutter="20">
          <el-col :span="12"><el-form-item label="合同编号"><el-input v-model="varForm.contract_no" disabled /></el-form-item></el-col>
          <el-col :span="12">
            <el-form-item label="状态"><el-select v-model="varForm.status" style="width:100%"><el-option label="进行中" value="进行中" /><el-option label="已完成" value="已完成" /><el-option label="已取消" value="已取消" /></el-select></el-form-item>
          </el-col>
        </el-row>
        <el-row :gutter="20">
          <el-col :span="12"><el-form-item label="客户姓名"><el-input v-model="varForm.customer_name" /></el-form-item></el-col>
          <el-col :span="12"><el-form-item label="客户电话"><el-input v-model="varForm.customer_phone" /></el-form-item></el-col>
        </el-row>
        <el-row :gutter="20">
          <el-col :span="12"><el-form-item label="身份证号"><el-input v-model="varForm.id_card" /></el-form-item></el-col>
          <el-col :span="12"><el-form-item label="合同金额"><el-input-number v-model="varForm.total_amount" :min="0" style="width:100%" /></el-form-item></el-col>
        </el-row>
        <el-row :gutter="20">
          <el-col :span="24"><el-form-item label="施工地址"><el-input v-model="varForm.engineering_address" type="textarea" :rows="2" /></el-form-item></el-col>
        </el-row>
        <el-row :gutter="20">
          <el-col :span="12"><el-form-item label="签订日期"><el-date-picker v-model="varForm.sign_date" type="date" value-format="YYYY-MM-DD" style="width:100%" /></el-form-item></el-col>
          <el-col :span="12"><el-form-item label="项目名称"><el-input v-model="varForm.project_name" /></el-form-item></el-col>
        </el-row>
        <el-row :gutter="20">
          <el-col :span="12"><el-form-item label="开工日期"><el-date-picker v-model="varForm.start_date" type="date" value-format="YYYY-MM-DD" style="width:100%" /></el-form-item></el-col>
          <el-col :span="12"><el-form-item label="竣工日期"><el-date-picker v-model="varForm.end_date" type="date" value-format="YYYY-MM-DD" style="width:100%" /></el-form-item></el-col>
        </el-row>
        
        <template v-if="customVariables.length > 0">
          <el-divider content-position="left">自定义变量</el-divider>
          <el-row :gutter="20" v-for="cv in customVariables" :key="cv.name">
            <el-col :span="24"><el-form-item :label="cv.label"><el-input v-model="varForm[cv.name]" /></el-form-item></el-col>
          </el-row>
        </template>
        
        <el-divider content-position="left">管理自定义变量</el-divider>
        <div class="custom-var-list">
          <el-tag v-for="cv in customVariables" :key="cv.name" type="success" closable @close="removeCustomVar(cv)" style="margin:3px;">{{ cv.label }}</el-tag>
          <el-button size="small" type="primary" plain @click="openAddCustomVar">+ 添加</el-button>
        </div>
      </el-form>
      <template #footer>
        <el-button @click="showVarDialog=false">取消</el-button>
        <el-button type="primary" @click="saveVariables">保存变量</el-button>
      </template>
    </el-dialog>

    <!-- 保存模板 -->
    <el-dialog v-model="showTemplateDialog" title="保存为模板" width="400px">
      <el-form :model="templateForm" label-width="80px">
        <el-form-item label="模板名称"><el-input v-model="templateForm.name" placeholder="请输入模板名称" /></el-form-item>
        <el-form-item label="模板分类">
          <el-select v-model="templateForm.category" style="width:100%">
            <el-option label="装修合同" value="decoration" /><el-option label="设计合同" value="design" /><el-option label="其他" value="other" />
          </el-select>
        </el-form-item>
        <el-form-item label="模板类型">
          <el-radio-group v-model="templateForm.template_type">
            <el-radio label="personal">个人模板</el-radio><el-radio label="system">系统模板</el-radio>
          </el-radio-group>
        </el-form-item>
      </el-form>
      <template #footer>
        <el-button @click="showTemplateDialog=false">取消</el-button>
        <el-button type="primary" @click="doSaveTemplate">保存</el-button>
      </template>
    </el-dialog>

    <!-- 添加自定义变量 -->
    <el-dialog v-model="showAddCustomVarDialog" title="添加自定义变量" width="350px">
      <el-form :model="newCustomVar" label-width="80px">
        <el-form-item label="变量名"><el-input v-model="newCustomVar.name" placeholder="如: my_field" /></el-form-item>
        <el-form-item label="显示名"><el-input v-model="newCustomVar.label" placeholder="如: 我的字段" /></el-form-item>
      </el-form>
      <template #footer>
        <el-button @click="showAddCustomVarDialog=false">取消</el-button>
        <el-button type="primary" @click="addCustomVar">添加</el-button>
      </template>
    </el-dialog>

    <!-- 导入模板 -->
    <el-dialog v-model="showImportDialog" title="导入模板" width="600px">
      <el-tabs v-model="importTab">
        <el-tab-pane label="系统模板" name="system"></el-tab-pane>
        <el-tab-pane label="个人模板" name="personal"></el-tab-pane>
      </el-tabs>
      <div class="template-list">
        <el-radio-group v-model="selectedTemplateId">
          <el-radio v-for="t in filteredImportTemplates" :key="t.id" :label="t.id" style="display:block;margin:10px 0">{{ t.name }}</el-radio>
        </el-radio-group>
        <div v-if="filteredImportTemplates.length === 0" style="text-align:center;color:#999;padding:20px">暂无模板</div>
      </div>
      <template #footer>
        <el-button @click="showImportDialog=false">取消</el-button>
        <el-button type="primary" @click="doImportTemplate" :disabled="!selectedTemplateId">导入</el-button>
      </template>
    </el-dialog>
  </div>
</template>

<script setup>
import { ref, reactive, computed, onMounted, nextTick, shallowRef, watch } from 'vue'
import axios from 'axios'
import { ElMessage, ElMessageBox } from 'element-plus'
import { Plus } from '@element-plus/icons-vue'
import { useEditor, EditorContent } from '@tiptap/vue-3'
import StarterKit from '@tiptap/starter-kit'
import Underline from '@tiptap/extension-underline'
import TextAlign from '@tiptap/extension-text-align'
import Placeholder from '@tiptap/extension-placeholder'
import Highlight from '@tiptap/extension-highlight'
import { TextStyle } from '@tiptap/extension-text-style'
import Typography from '@tiptap/extension-typography'
import { Link } from '@tiptap/extension-link'
import { Table } from '@tiptap/extension-table'
import { TableRow } from '@tiptap/extension-table-row'
import { TableCell } from '@tiptap/extension-table-cell'
import { TableHeader } from '@tiptap/extension-table-header'
import { Document, Packer, Paragraph, TextRun, HeadingLevel, Table as DocxTable, TableRow as DocxTableRow, TableCell as DocxTableCell, WidthType, AlignmentType, BorderStyle, convertInchesToTwip, ShadingType, VerticalAlign, Header, Footer } from 'docx'
import { saveAs } from 'file-saver'

const contractList = ref([])
const searchKey = ref('')
const showVarFillDialog = ref(false)
const showContentDialog = ref(false)
const showVarDialog = ref(false)
const showTemplateDialog = ref(false)
const showAddCustomVarDialog = ref(false)
const showImportDialog = ref(false)
const varFormRef = ref(null)
const currentContractId = ref(null)
const importTab = ref('system')
const selectedTemplateId = ref(null)
const templateList = ref([])
const templateSourceContent = ref('')
const rawContent = ref('')
const editorMode = ref('edit')

// A4 尺寸（单位px，96dpi）
const MM_TO_PX = 96 / 25.4
const A4_WIDTH_PX = Math.round(210 * MM_TO_PX)
const A4_HEIGHT_PX = Math.round(297 * MM_TO_PX)
const PAGE_HORIZONTAL_PADDING_PX = Math.round(20 * MM_TO_PX)
const PREVIEW_BODY_TOP_PX = Math.round(28 * MM_TO_PX)
const PREVIEW_BODY_BOTTOM_PX = Math.round(22 * MM_TO_PX)

// PDF body 内容区高度（不用 preview 的 top/bottom 直接换算）
// PDF .page flex: column → header=12mm + body(flex:1) + footer=12mm
// .body { padding:8mm 20mm } → 内容区 = 297mm - 12*2 - 8*2 = 257mm = 973px
// 减去 20mm(76px) 安全余量，避免 estimateHeight 估算误差导致溢出到页脚
// 最终 BODY_HEIGHT_PX = 973 - 76 = 897px ≈ 237mm，内容高度低于 PDF body 实际可用
// 这样即使 estimateHeight 有 5-10% 误差（如 line-height/字体渲染差异），也有足够余量
const PDF_BODY_CONTENT_PX = Math.round(297 * MM_TO_PX) - 2 * Math.round(12 * MM_TO_PX) - 2 * Math.round(8 * MM_TO_PX)
const SAFETY_PX = Math.round(20 * MM_TO_PX)
const BODY_HEIGHT_PX = PDF_BODY_CONTENT_PX - SAFETY_PX

// 把 HTML 内容分成多页
const computePageBreaks = (html) => {
  if (!html || html === '<p></p>' || html === '<p><br></p>') return ['']

  // 用 DOM 解析内容
  const parser = new DOMParser()
  const doc = parser.parseFromString(html, 'text/html')
  const body = doc.body

  const pages = []
  let currentPage = ''
  let currentHeight = 0

  // 遍历所有子节点
  const children = Array.from(body.childNodes)

  const estimateHeight = (el) => {
    const clone = el.cloneNode(true)
    clone.style.position = 'absolute'
    clone.style.visibility = 'hidden'
    clone.style.width = (A4_WIDTH_PX - PAGE_HORIZONTAL_PADDING_PX * 2) + 'px'
    clone.style.whiteSpace = 'pre-wrap'
    clone.style.wordBreak = 'break-word'
    // 使用与 CSS .a4-body 和 PDF body-wrap 完全一致的字体参数（12pt ≈ 16px at 96dpi）
    clone.style.font = '16px SimSun, Microsoft YaHei, serif'
    clone.style.lineHeight = '1.8'
    // 匹配 .body-wrap 的 text-align:justify
    clone.style.textAlign = 'justify'
    document.body.appendChild(clone)
    const h = clone.offsetHeight
    document.body.removeChild(clone)
    return h
  }

  for (const child of children) {
    if (child.nodeType === 3) { // Text node
      const text = child.textContent
      if (!text.trim()) continue
      const span = document.createElement('span')
      span.textContent = text
      const p = document.createElement('p')
      p.appendChild(span)
      const h = estimateHeight(p)
      if (currentHeight + h > BODY_HEIGHT_PX && currentHeight > 0) {
        pages.push(currentPage)
        currentPage = ''
        currentHeight = 0
      }
      currentPage += child.textContent
      currentHeight += h
    } else if (child.nodeType === 1) { // Element node
      const clone = child.cloneNode(true)
      // 去掉分页符元素
      if (clone.tagName === 'HR') {
        if (currentHeight > 0) {
          pages.push(currentPage)
          currentPage = ''
          currentHeight = 0
        }
        continue
      }
      const h = estimateHeight(clone)
      if (currentHeight + h > BODY_HEIGHT_PX && currentHeight > 0) {
        pages.push(currentPage)
        currentPage = ''
        currentHeight = 0
      }
      currentPage += new XMLSerializer().serializeToString(child)
      currentHeight += h
    }
  }

  if (currentPage || currentHeight > 0) {
    pages.push(currentPage)
  }

  return pages.length > 0 ? pages : ['']
}

// 监听编辑器内容变化，切换到预览模式时重新计算分页
const updatePageBreaks = () => {
  if (editorMode.value === 'preview') {
    const html = editor.value?.getHTML() || ''
    pageBreaks.value = computePageBreaks(html)
  }
}

const pageBreaks = ref([''])

// 颜色选择器
const showColorPicker = ref(false)
const showBgColorPicker = ref(false)
const textColor = ref('#000000')
const bgColor = ref('#ffff00')

// Tiptap 编辑器
const editor = useEditor({
  extensions: [
    StarterKit,
    Underline,
    TextAlign.configure({ types: ['heading', 'paragraph'] }),
    Highlight.configure({ multicolor: true }),
    TextStyle,
    Typography,
    Link,
    Table.configure({ resizable: true }),
    TableRow,
    TableCell,
    TableHeader,
    Placeholder.configure({ placeholder: '在此输入合同内容...' }),
  ],
  content: '',
  onUpdate: ({ editor }) => {
    varForm.content = editor.getHTML()
    updatePageBreaks()
  },
})

const refreshPreviewPages = () => {
  const html = editor.value?.getHTML() || ''
  pageBreaks.value = computePageBreaks(html)
}

const setEditorMode = (mode) => {
  editorMode.value = mode
  if (mode === 'preview') {
    nextTick(refreshPreviewPages)
  }
}

watch(editorMode, (val) => {
  if (val === 'preview') {
    const html = editor.value?.getHTML() || ''
    pageBreaks.value = computePageBreaks(html)
  }
})

// 设置链接
const setLink = () => {
  const url = prompt('输入链接地址:')
  if (url) {
    editor.value.chain().focus().setLink({ href: url }).run()
  } else {
    editor.value.chain().focus().unsetLink().run()
  }
}

// 插入分页符
const insertPageBreak = () => {
  editor.value.chain().focus().setHardBreak().run()
  editor.value.chain().focus().insertContent('<hr style="page-break-after:always;border:none;border-top:1px dashed #ccc;margin:20px 0;" />').run()
}

// 对话框打开后的初始化
const onDialogOpened = () => {
  editorMode.value = 'edit'
  editor.value?.commands.setContent(rawContent.value || '<p></p>')
  nextTick(() => {
    editor.value?.commands.focus()
    if (editorMode.value === 'preview') {
      updatePageBreaks()
    }
  })
}

// 清洗粘贴的HTML - 保留样式但清理危险内容
const cleanPasteHTML = (html) => {
  let clean = html
    .replace(/<script[\s\S]*?<\/script>/gi, '')
    .replace(/<style[\s\S]*?<\/style>/gi, '')
    .replace(/on\w+="[^"]*"/gi, '')
    .replace(/on\w+='[^']*'/gi, '')
    .replace(/javascript:/gi, '')
    .replace(/<iframe[\s\S]*?<\/iframe>/gi, '')
    .replace(/<object[\s\S]*?<\/object>/gi, '')
    .replace(/<embed[\s\S]*?>/gi, '')
    .replace(/<form[\s\S]*?<\/form>/gi, '')
    .replace(/<input[\s\S]*?>/gi, '')
    .replace(/<button[\s\S]*?<\/button>/gi, '')
    .replace(/<select[\s\S]*?<\/select>/gi, '')
    .replace(/<textarea[\s\S]*?<\/textarea>/gi, '')
  return clean
}

