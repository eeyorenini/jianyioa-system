// 构建单页PDF的HTML
const buildPdfPageHtml = (bodyHtml, contractNo, categoryName, pageNum, totalPages) => {
  // 使用 flex 布局，让 Puppeteer 可靠地排列页眉/正文/页脚
  // A4: 210mm x 297mm
  // 页眉固定 12mm 高度（含底部边线）
  // 正文 flex:1 自动填充中间
  // 页脚固定 12mm 高度（含顶部边线）
  return `<!DOCTYPE html><html><head><meta charset="UTF-8"><style>
    *{margin:0;padding:0;box-sizing:border-box}
    @page{size:210mm 297mm;margin:0}
    html,body{width:210mm;height:297mm;margin:0;background:white;font-family:SimSun,Microsoft YaHei,serif;overflow:hidden}
    .page{width:210mm;height:297mm;display:flex;flex-direction:column;background:white}
    .header{height:12mm;display:flex;align-items:center;justify-content:center;font-size:8pt;color:#999;border-bottom:1px solid #e4e8f0;padding:0 20mm;flex-shrink:0}
    .body{flex:1;padding:8mm 20mm;overflow:hidden;font-family:SimSun,Microsoft YaHei,serif;font-size:12pt;line-height:1.6;text-align:justify}
    .footer{height:12mm;display:flex;align-items:center;justify-content:center;font-size:8pt;color:#999;border-top:1px solid #e4e8f0;padding:0 20mm;flex-shrink:0}
    .body p{margin:0.3em 0;text-indent:2em}
    .body h1{font-size:18pt;font-weight:bold;margin:0.5em 0;text-align:center;text-indent:0}
    .body h2{font-size:16pt;font-weight:bold;margin:0.5em 0;text-indent:0}
    .body h3{font-size:14pt;font-weight:bold;margin:0.4em 0;text-indent:0}
    .body ul,.body ol{padding-left:2em;margin:0.3em 0}
    .body li{margin:0.2em 0}
    .body table{border-collapse:collapse;width:100%;margin:0.5em 0}
    .body td,.body th{border:1px solid #333;padding:4px 8px;font-size:11pt}
    .body blockquote{border-left:3px solid #409eff;padding-left:1em;margin:0.5em 0;color:#666}
    .body strong,.body b{font-weight:bold}
    .body em,.body i{font-style:italic}
    .body u{text-decoration:underline}
    .body s,.body strike{text-decoration:line-through}
    .body mark{background:#ffff00;padding:0.1em 0.2em}
    .body a{color:#409eff;text-decoration:underline}
    .body code{background:#f5f5f5;padding:0 4px;border-radius:2px}
    .body pre{background:#1e1e1e;color:#d4d4d4;padding:8px;border-radius:4px;overflow-x:auto}
    .body hr{border:none;border-top:2px dashed #409eff;margin:20px 0}
  </style></head><body>
  <div class="page">
    <div class="header">简逸装饰 | ${contractNo || ''} | ${categoryName}</div>
    <div class="body">${bodyHtml}</div>
    <div class="footer">第 ${pageNum} / ${totalPages} 页</div>
  </div>
</body></html>`
}

// 导出PDF - 使用 Puppeteer 后端渲染
const exportPdf = async (row) => {
  try {
    ElMessage.info('正在生成PDF，请稍候...')

    const categoryName = categoryMap[row.category] || '装修合同'
    let content = row.content || ''

    // 替换变量
    let processedContent = content
    Object.keys(row).forEach(key => {
      processedContent = processedContent.replace(new RegExp('\\{' + key + '\\}', 'g'), row[key] || '')
    })

    // 用预览模式的分页算法计算分页
    const pages = computePageBreaks(processedContent)
    const total = pages.length

    // 构建多页PDF数据，每页包含完整header+body+footer
    const pdfPages = pages.map((bodyHtml, idx) => ({
      html: buildPdfPageHtml(bodyHtml, row.contract_no, categoryName, idx + 1, total)
    }))

    const response = await axios.post('/api/export-pdf-multi', {
      pages: pdfPages,
      filename: '合同_' + (row.contract_no || 'export') + '.pdf'
    }, { responseType: 'blob' })

    // 下载 PDF
    const url = window.URL.createObjectURL(new Blob([response.data]))
    const link = document.createElement('a')
    link.href = url
    link.download = '合同_' + (row.contract_no || 'export') + '.pdf'
    document.body.appendChild(link)
    link.click()
    document.body.removeChild(link)
    window.URL.revokeObjectURL(url)

    ElMessage.success('PDF导出成功')
  } catch (e) {
    ElMessage.error('导出PDF失败: ' + (e.message || '未知错误'))
    console.error('导出PDF详细错误:', e)
  }
}

