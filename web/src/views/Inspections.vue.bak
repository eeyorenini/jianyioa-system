<template>
  <div class="inspections">
    <el-card>
      <template #header>
        <div class="card-header">
          <span>工地巡检</span>
          <el-button type="primary" @click="showAddDialog = true">
            <el-icon><Plus /></el-icon>
            新增巡检
          </el-button>
        </div>
      </template>
      <el-table :data="inspectionList" style="width: 100%">
        <el-table-column prop="project_name" label="项目名称" width="180" />
        <el-table-column prop="inspector_name" label="检查人" width="100" />
        <el-table-column prop="score" label="评分" width="100">
          <template #default="scope">
            <el-tag :type="getScoreType(scope.row.score)">{{ scope.row.score }}分</el-tag>
          </template>
        </el-table-column>
        <el-table-column prop="issues" label="问题描述" />
        <el-table-column prop="result" label="检查结果" width="120">
          <template #default="scope">
            <el-tag :type="getResultType(scope.row.result)">{{ scope.row.result || '待整改' }}</el-tag>
          </template>
        </el-table-column>
        <el-table-column prop="rectify_status" label="整改状态" width="100">
          <template #default="scope">
            <el-tag :type="scope.row.rectify_status === '已整改' ? 'success' : 'danger'">
              {{ scope.row.rectify_status }}
            </el-tag>
          </template>
        </el-table-column>
        <el-table-column prop="created_at" label="检查时间" width="120" />
        <el-table-column label="操作" width="180">
          <template #default="scope">
            <el-button size="small" @click="handleEdit(scope.row)">整改</el-button>
            <el-button type="danger" size="small" @click="handleDelete(scope.row.id)">删除</el-button>
          </template>
        </el-table-column>
      </el-table>
    </el-card>

    <el-dialog v-model="showAddDialog" :title="isEdit ? '整改记录' : '新增巡检'" width="600px">
      <el-form :model="form" label-width="100px">
        <el-form-item label="项目名称">
          <el-input v-model="form.project_name" />
        </el-form-item>
        <el-form-item label="检查时间">
          <el-date-picker v-model="form.created_at" type="datetime" placeholder="选择检查时间" value-format="YYYY-MM-DD HH:mm:ss" style="width: 100%" />
        </el-form-item>
        <el-form-item label="检查人">
          <el-input v-model="form.inspector_name" />
        </el-form-item>
        <el-form-item label="评分">
          <el-input-number v-model="form.score" :min="0" :max="100" />
        </el-form-item>
        <el-form-item label="问题描述">
          <el-input v-model="form.issues" type="textarea" :rows="3" />
        </el-form-item>
        <el-form-item label="检查结果">
          <el-select v-model="form.result">
            <el-option label="合格" value="合格" />
            <el-option label="待整改" value="待整改" />
            <el-option label="不合格" value="不合格" />
          </el-select>
        </el-form-item>
        <el-form-item label="整改状态">
          <el-select v-model="form.rectify_status">
            <el-option label="待整改" value="待整改" />
            <el-option label="已整改" value="已整改" />
          </el-select>
        </el-form-item>
      </el-form>
      <template #footer>
        <el-button @click="closeDialog">取消</el-button>
        <el-button type="primary" @click="handleSave">确定</el-button>
      </template>
    </el-dialog>
  </div>
</template>

<script setup>
import { ref, reactive, onMounted } from 'vue'
import axios from 'axios'
import { ElMessage } from 'element-plus'

const inspectionList = ref([])
const showAddDialog = ref(false)
const isEdit = ref(false)
const form = reactive({
  id: null,
  project_id: null,
  project_name: '',
  inspector_id: null,
  inspector_name: '管理员',
  score: 100,
  status: '待整改',
  issues: '',
  result: '合格',
  rectify_status: '待整改',
  created_at: ''
});

const getScoreType = (score) => {
  if (score >= 90) return 'success'
  if (score >= 60) return 'warning'
  return 'danger'
}

const getResultType = (result) => {
  const types = { '合格': 'success', '待整改': 'warning', '不合格': 'danger' }
  return types[result] || 'info'
}

const loadData = async () => {
  try {
    const res = await axios.get('/api/inspections')
    inspectionList.value = res.data
  } catch (error) {
    console.error('加载失败:', error)
  }
}

const handleEdit = (row) => {
  isEdit.value = true
  Object.assign(form, row)
  showAddDialog.value = true
}

const handleSave = async () => {
  try {
    if (isEdit.value) {
      await axios.put(`/api/inspections/${form.id}`, form)
      ElMessage.success('更新成功')
    } else {
      await axios.post('/api/inspections', form)
      ElMessage.success('添加成功')
    }
    closeDialog()
    loadData()
  } catch (error) {
    ElMessage.error('操作失败')
  }
}

const handleDelete = async (id) => {
  try {
    await axios.delete(`/api/inspections/${id}`)
    ElMessage.success('删除成功')
    loadData()
  } catch (error) {
    ElMessage.error('删除失败')
  }
}

const closeDialog = () => {
  showAddDialog.value = false
  isEdit.value = false
  form.id = null
  form.project_id = null
  form.project_name = ''
  form.inspector_id = null
  form.inspector_name = '管理员'
  form.score = 100
  form.status = '待整改'
  form.issues = ''
  form.result = '合格'
  form.rectify_status = '待整改'
  form.created_at = ''
});

onMounted(() => {
  loadData()
})
</script>

<style scoped>
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
</style>
