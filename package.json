{
  "name": "jianyioa-system",
  "version": "2.6.1",
  "description": "简逸ERP (MySQL版)",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node server/server.js",
    "build": "cd web && npm install && npm run build",
    "install:server": "cd server && npm install --legacy-peer-deps",
    "install:web": "cd web && npm install --legacy-peer-deps",
    "build:mobile": "cd jianyioa-app/mobile && rm -rf dist && npm run build:h5 && rsync -a --delete dist/build/h5/ ../../server/public-mobile-h5/",
    "build:all": "npm run build && npm run build:mobile",
    "smoke": "node scripts/smoke-test.js",
    "routes": "node scripts/route-inventory.js",
    "release": "bash scripts/make-release.sh",
    "backup": "bash scripts/backup-all.sh"
  },
  "dependencies": {
    "@playwright/test": "^1.63.0",
    "express": "^4.18.2"
  }
}
